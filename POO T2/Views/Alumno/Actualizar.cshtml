@model POO_T2.Models.Alumno

@{
    ViewBag.Title = "Actualizar Alumno";
}

<h2>Actualizar Alumno</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@using (Html.BeginForm("Actualizar", "Alumno", FormMethod.Post))
{
    @Html.Hidden("dniOriginal", (string)ViewBag.DniOriginal)
    <div class="form-group">
        @Html.LabelFor(m => m.Dni)
        @Html.TextBoxFor(m => m.Dni, new { @class = "form-control", maxlength = 8, required = "required" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Nombres)
        @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Apellidos)
        @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Carrera)
        @Html.TextBoxFor(m => m.Carrera, new { @class = "form-control", required = "required" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Ciclo)
        @Html.TextBoxFor(m => m.Ciclo, new { @class = "form-control", type = "number", min = 1, max = 10, required = "required" })
    </div>
    <br />
    <button type="submit">Actualizar</button>
    @Html.ActionLink("Volver", "Index")
}